# NetGuardian AI - Backend Environment Configuration Template
# Copy this file to .env and adjust values for local development

# Flask Environment (development / production)
FLASK_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=True

# Server Port and Host
HOST=127.0.0.1
PORT=5000

# Security (Generate a secure secret key for production)
SECRET_KEY=netguardian-ai-dev-secret-key-change-in-production

# Database Configuration
DATABASE_PATH=data/netguardian.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
